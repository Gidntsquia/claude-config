   if [ "$OS" = windows ] && cp -R "$src" "$dst" 2>/dev/null; then
-    copies record "$dst"
     echo "  (copied $dst: this Windows account cannot make symlinks; rerun install.sh after updates)"; return 0
   fi
   echo "install: could not link $dst: ${err:-ln -s failed}" >&2; exit 1
