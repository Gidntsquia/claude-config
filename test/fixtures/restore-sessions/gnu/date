#!/usr/bin/env python3
# The part of GNU `date -d` the restore-sessions scripts use, for systems whose date lacks it.
import os, re, sys, time
from datetime import datetime
args = sys.argv[1:]
if len(args) < 2 or args[0] != "-d":
    os.execv("/bin/date", ["date"] + args)
value, fmt = args[1], args[2][1:] if len(args) > 2 else "%a %b %d %H:%M:%S %Z %Y"
try:
    if value.startswith("@"):
        epoch = int(value[1:])
    else:
        v = re.sub(r"^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) ", "", value)
        v = re.sub(r" [A-Z]{3,4}$", "", v)
        epoch = int(datetime.fromisoformat(v).timestamp())
except ValueError:
    sys.exit("date: invalid date '%s'" % value)
print(epoch if fmt == "%s" else time.strftime(fmt, time.localtime(epoch)))
