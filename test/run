#!/bin/bash
# The one test command.   test/run [quick|machine|docker|all]      (default: quick)
#
#   quick    test/quick/*.bats and the pytest files: temp HOME, no network, no installed app. Every OS.
#   machine  test/machine/*.bats: the real tools (Firefox, keychain, network). macOS and Linux.
#   docker   test/docker/*.bats: needs Docker. Linux.
#   all      the three tiers in that order.
#
# Order: lint over the test files, then the tier's tests (several files at once: TEST_JOBS). The last line is `PASS <n> tests` (exit 0) or
# `FAIL <failed> of <n>` (exit 1). Exit 2 means the suite could not start (bad argument, no bats).
# bats comes from the submodule test/vendor/bats-core; when that is absent, from a `bats` on PATH
# (`brew install bats-core`). bash 3.2; pytest for the python files.

set -u
export TZ=UTC LC_ALL=C

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
BATS="$HERE/vendor/bats-core/bin/bats"

tier="quick"
[ $# -gt 0 ] && { tier="$1"; shift; }
case "$tier" in
  quick|machine|docker|all) ;;
  *) echo "usage: test/run [quick|machine|docker|all]" >&2; exit 2 ;;
esac
[ $# -gt 0 ] && { echo "test/run: unknown argument: $1" >&2; echo "usage: test/run [quick|machine|docker|all]" >&2; exit 2; }

if [ "$tier" = all ]; then tiers="quick machine docker"; else tiers="$tier"; fi

total=0
failed=0

# ---- lint ---------------------------------------------------------------------------------------------------
# One problem per line: `lint: <file>:<line>: <rule>`. Each problem counts as one failed test. The rules and why
# they exist are in plans/research/testing-framework.md ("False reds"); there is no per-line way to switch one off.
#   sleep            waiting is `wait_until <seconds> <command>` (test/helpers/wait.bash)
#   curl, wget       no network in the quick tier
#   $HOME, ~         a test's home is "$TEST_HOME" from temp_home (test/helpers/home.bash)
#   bare skip        `skip "<tool> missing"`: a skip says why
#   fixed port       two runs on one machine would collide; ask the OS for a free port
#   bare ! [[ ((     under macOS's bash 3.2 such a line fails silently in the middle of a test
lint() {
  local f rel problems=0 out
  for f in "$HERE"/quick/*.bats "$HERE"/machine/*.bats "$HERE"/docker/*.bats "$HERE"/helpers/*.bash; do
    [ -f "$f" ] || continue
    rel="${f#$REPO/}"
    out="$(awk -v file="$rel" '
      function bad(rule) { printf "lint: %s:%d: %s\n", file, NR, rule; n++ }
      BEGIN {
        quick   = (file ~ /^test\/quick\//)
        waitlib = (file == "test/helpers/wait.bash")
        homelib = (file == "test/helpers/home.bash")
      }
      /^[ \t]*#/ { next }
      {
        line = $0
        if (!waitlib && (line ~ /(^|[^A-Za-z0-9_.\/-])((\/usr)?\/bin\/)?sleep([ \t]|$)/ || line ~ /time\.sleep\(/))
          bad("sleep: use wait_until <seconds> <command>")
        if (quick && line ~ /(^|[^A-Za-z0-9_.\/-])((\/usr)?\/bin\/)?(curl|wget)([ \t]|$)/)
          bad("curl or wget in the quick tier: no network here")
        if (!homelib && (line ~ /\$HOME([^A-Za-z0-9_]|$)/ || line ~ /\$\{HOME[}:]/ || line ~ /(^|[ \t="\047:])~(\/|[ \t"\047]|$)/))
          bad("$HOME or ~: use \"$TEST_HOME\" from temp_home")
        if (file ~ /\.bats$/ && line ~ /^[ \t]*(!|\[\[|\(\()[ \t]/ && line !~ /(\|\||&&|\\$)/)
          bad("a bare !, [[ or (( cannot fail a test under bash 3.2: use [ ], run with assert_failure, or add || false")
        if (line ~ /(^|[ \t;&|])skip[ \t]*($|;|\}|#)/)
          bad("skip with no reason: skip \"<tool> missing\"")
        if (line ~ /(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\]):[0-9][0-9]+/ || line ~ /(--port|-port|PORT)[ =][0-9][0-9]+/)
          bad("fixed port number: ask the OS for a free port")
      }
      END { exit (n > 0) }
    ' "$f")"
    if [ -n "$out" ]; then
      echo "$out"
      problems=$((problems + $(printf '%s\n' "$out" | wc -l)))
    fi
  done
  total=$((total + problems))
  failed=$((failed + problems))
  [ "$problems" -eq 0 ] && echo "lint: clean" || echo "lint: $problems problem(s)"
}

# ---- bats ---------------------------------------------------------------------------------------------------
# The submodule's bats; without it a bats on PATH. Neither: exit 2 (or 1 when the lint already failed).
find_bats() {
  [ -f "$BATS" ] && return 0
  if command -v bats >/dev/null 2>&1; then
    BATS="$(command -v bats)"
    echo "test/vendor/bats-core is absent: using $BATS ($("$BATS" --version 2>/dev/null))"
    return 0
  fi
  echo "test/vendor/bats-core is missing and no bats is on PATH"
  echo "run: git submodule update --init      (or: brew install bats-core)"
  # A lint problem is a failure whether or not the tests could start.
  [ "$failed" -gt 0 ] && { echo "FAIL $failed of $total"; exit 1; }
  exit 2
}

# Each file runs in its own bats process, TEST_JOBS (4) at a time; tests inside a file run in order. A file's
# output is printed whole when it ends. A file still running after TEST_FILE_TIMEOUT seconds (900) is killed with
# everything it started and counts as failed. bats' own BATS_TEST_TIMEOUT is not used: it leaves a sleep behind
# for every test, and a test that calls `wait` then waits for it.
JOBS="${TEST_JOBS:-4}"
FILE_TIMEOUT="${TEST_FILE_TIMEOUT:-900}"
WORK=""
pids=()    # slot -> process group of the running file, "" when free

stop_all() {
  local p
  for p in ${pids[@]+"${pids[@]}"}; do [ -n "$p" ] && kill -9 -- "-$p" 2>/dev/null; done
  [ -n "$WORK" ] && rm -rf "$WORK"
}
trap stop_all EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# finish_file <file> <log> <exit status> <seconds> <timed out: 0|1>: print the output and add up its tests.
finish_file() {
  local f="$1" out rc="$3" ok notok plan written missing rel="${1#$REPO/}"
  out="$(cat "$2")"
  printf -- '-- %s (%s s)\n%s\n' "$rel" "$4" "$out"
  ok="$(printf '%s\n' "$out" | grep -c '^ok ')"
  notok="$(printf '%s\n' "$out" | grep -c '^not ok ')"
  total=$((total + ok + notok))
  failed=$((failed + notok))
  # bats itself stopped (a syntax error, a crash, a killed run): that is never a pass, whatever lines it printed.
  # bats also drops the tests of a file it cannot parse and still exits 0, so the tests are counted here too.
  written="$(grep -c '^[[:space:]]*@test[[:space:]]' "$f")"
  plan="$(printf '%s\n' "$out" | sed -n 's/^1\.\.\([0-9][0-9]*\)$/\1/p' | head -1)"
  [ -n "$plan" ] && [ "$plan" -gt "$written" ] && written="$plan"
  missing=$((written - ok - notok))
  [ "$missing" -lt 0 ] && missing=0
  if [ "$5" = 1 ]; then
    echo "$rel: took longer than $FILE_TIMEOUT s and was killed"
    [ "$missing" -eq 0 ] && missing=1
  elif [ "$missing" -gt 0 ]; then
    echo "$rel: $written tests are written and bats reported $((ok + notok))"
  elif [ $((ok + notok)) -eq 0 ]; then
    echo "$rel: bats ran no test"; missing=1
  elif [ "$notok" -eq 0 ] && [ "$rc" != 0 ]; then
    echo "$rel: bats exited $rc with no failing test"; missing=1
  fi
  total=$((total + missing))
  failed=$((failed + missing))
}

# Files whose name starts with `_` (the template) are not run.
run_bats() {
  local t="$1" f i n next=0 running=0 timed_out rc
  local files=() slot_file=() slot_start=()
  for f in "$HERE/$t"/*.bats; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in _*) continue ;; esac
    files[${#files[@]}]="$f"
  done
  n=${#files[@]}
  if [ "$n" -eq 0 ]; then echo "$t: no test files"; return; fi
  echo "== $t ($n files, $JOBS at a time)"
  WORK="$(mktemp -d "${TMPDIR:-/tmp}/test-run.XXXXXX")"
  while [ "$next" -lt "$n" ] || [ "$running" -gt 0 ]; do
    i=0
    while [ "$i" -lt "$JOBS" ]; do
      if [ -z "${pids[$i]:-}" ] && [ "$next" -lt "$n" ]; then
        set -m   # a process group of its own, so a hung file can be killed whole
        ( cd "$REPO" && exec "$BATS" --tap "${files[$next]}" </dev/null >"$WORK/$i.log" 2>&1 ) &
        pids[$i]=$!
        set +m
        slot_file[$i]="${files[$next]}"; slot_start[$i]=$SECONDS
        next=$((next + 1)); running=$((running + 1))
      elif [ -n "${pids[$i]:-}" ]; then
        timed_out=0
        if kill -0 "${pids[$i]}" 2>/dev/null; then
          [ $((SECONDS - slot_start[i])) -ge "$FILE_TIMEOUT" ] || { i=$((i + 1)); continue; }
          timed_out=1
          kill -9 -- "-${pids[$i]}" 2>/dev/null
        fi
        wait "${pids[$i]}" 2>/dev/null; rc=$?
        finish_file "${slot_file[$i]}" "$WORK/$i.log" "$rc" $((SECONDS - slot_start[i])) "$timed_out"
        pids[$i]=""; running=$((running - 1))
        continue   # fill this slot again at once
      fi
      i=$((i + 1))
    done
    [ "$running" -gt 0 ] && sleep 0.2
  done
  rm -rf "$WORK"; WORK=""
}

# ---- pytest (the python helpers; quick tier) ----------------------------------------------------------------
run_pytest() {
  local dirs="" d out line p f e rc
  for d in "$REPO"/skills/*/tests "$REPO"/hooks/*/tests "$REPO"/helper-mcp/tests "$REPO"/assistant/tests; do
    ls "$d"/test_*.py >/dev/null 2>&1 && dirs="$dirs $d"
  done
  [ -n "$dirs" ] || return 0
  echo "== pytest"
  if python3 -c 'import pytest' 2>/dev/null; then
    # shellcheck disable=SC2086
    out="$(cd "$REPO" && python3 -m pytest -q -p no:cacheprovider $dirs 2>&1)"; rc=$?
  elif command -v uv >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    out="$(cd "$REPO" && uv run --quiet --group dev python -m pytest -q -p no:cacheprovider $dirs 2>&1)"; rc=$?
  else
    echo "pytest is missing: pip install pytest, or install uv"
    total=$((total + 1)); failed=$((failed + 1)); return
  fi
  printf '%s\n' "$out"
  line="$(printf '%s\n' "$out" | grep -E '^[0-9]+ (passed|failed|error)|, [0-9]+ (passed|failed|error)' | tail -1)"
  p="$(printf '%s\n' "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) passed.*/\1/p; s/^\([0-9][0-9]*\) passed.*/\1/p' | head -1)"
  f="$(printf '%s\n' "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) failed.*/\1/p; s/^\([0-9][0-9]*\) failed.*/\1/p' | head -1)"
  e="$(printf '%s\n' "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) errors\{0,1\}.*/\1/p; s/^\([0-9][0-9]*\) errors\{0,1\}.*/\1/p' | head -1)"
  p="${p:-0}"; f="${f:-0}"; e="${e:-0}"
  total=$((total + p + f + e))
  failed=$((failed + f + e))
  if [ $((p + f + e)) -eq 0 ]; then total=$((total + 1)); failed=$((failed + 1)); echo "pytest: no result line"
  elif [ $((f + e)) -eq 0 ] && [ "$rc" != 0 ]; then total=$((total + 1)); failed=$((failed + 1)); echo "pytest: exited $rc with no failing test"; fi
}

# ---- run ----------------------------------------------------------------------------------------------------
lint
find_bats
for t in $tiers; do
  run_bats "$t"
  [ "$t" = quick ] && run_pytest
done

if [ "$failed" -eq 0 ]; then
  echo "PASS $total tests"
  exit 0
fi
echo "FAIL $failed of $total"
exit 1
