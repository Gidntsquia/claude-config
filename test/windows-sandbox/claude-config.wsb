<!-- Windows Sandbox config for testing claude-config's install on a clean Windows. See README.md in this folder.
     It maps C:\claude-config-sandbox (holding this file and install-test.ps1) to C:\shared inside the Sandbox. -->
<Configuration>
  <VGpu>Enable</VGpu>
  <Networking>Enable</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\claude-config-sandbox</HostFolder>
      <SandboxFolder>C:\shared</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File C:\shared\install-test.ps1</Command>
  </LogonCommand>
</Configuration>
